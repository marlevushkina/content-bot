# ─── Required ───────────────────────────────────────────────────────────────

# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=

# Anthropic API key — https://console.anthropic.com/ (pay-as-you-go)
ANTHROPIC_API_KEY=

# Telegram user IDs allowed to use the bot. Comma-separated.
# Find yours by messaging @userinfobot. If left EMPTY the bot is open to
# everyone — anyone could trigger paid API calls. Always set this in production.
ALLOWED_USER_IDS=123456789,987654321

# ─── Persona / context ───────────────────────────────────────────────────────

# Name the bot writes as (e.g. Alex). Empty = neutral first person.
# The real voice and strategy live in the vault skills, not here.
AUTHOR_NAME=

# Your Telegram channel username without @ (optional). Used to read recent
# posts for context and to avoid repeating topics in the weekly plan.
TELEGRAM_CHANNEL=

# Path to the vault directory (skills + your raw notes). The default works for
# the bundled example vault.
VAULT_PATH=./vault

# ─── Optional ────────────────────────────────────────────────────────────────

# Deepgram API key for voice-message transcription — https://deepgram.com/
# Without it, voice messages are rejected; everything else works.
DEEPGRAM_API_KEY=
